# ---- Application ----
APP_NAME=E2M Insights
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# ---- Database (Docker Compose internal hostname is "postgres") ----
# Local non-Docker: postgresql+psycopg://csm:<password>@localhost:5432/e2m-insights
DATABASE_URL=postgresql+psycopg://csm:<password>@postgres:5432/e2m-insights
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ---- Redis ----
# Local non-Docker: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=60
REDIS_SOCKET_TIMEOUT_SECONDS=1.5

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# ---- LLM provider (server-side only; never expose keys to the frontend) ----
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_JSON_MODE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_RETRIES=2

# ---- Explicit bootstrap / demo data ----
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Admin
