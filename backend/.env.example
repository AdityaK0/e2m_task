# ---- Application ----
APP_NAME=Customer Success Platform
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
ALLOW_REGISTRATION=true

# ---- Database (Docker Compose internal hostname is "db") ----
# Local non-Docker: postgresql+psycopg2://csm:csm_local_password@localhost:5432/csm
DATABASE_URL=postgresql+psycopg2://csm:csm_local_password@db:5432/csm
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ---- Redis ----
# Local non-Docker: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=60
REDIS_SOCKET_TIMEOUT_SECONDS=1.5

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
# Local HTTP uses false. Production HTTPS must use true.
COOKIE_SECURE=false
# lax works for localhost. Cross-site production domains need none + Secure.
COOKIE_SAMESITE=lax
# Optional, e.g. .example.com when sharing cookies across subdomains
COOKIE_DOMAIN=

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# ---- AI provider (server-side only; never expose to the frontend) ----
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL (leave blank for api.openai.com)
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ---- Explicit bootstrap / demo data ----
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Admin
SEED_DEMO_DATA=false
