# Copy to .env to override Compose defaults. Never commit the real .env.
# Vercel project name: e2m-insights
# Backend service name: e2m-insights-api

# Ports exposed on the host
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL database name
POSTGRES_DB=e2m-insights

# Leave keys blank to demo the graceful "AI not configured" state.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_JSON_MODE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-unique-random-secret-of-at-least-32-characters

# Must match the browser-facing frontend origin
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Initial administrator and demo data
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=AdminPass123!
BOOTSTRAP_ADMIN_NAME=Platform Admin

# Database password used inside the Compose network
POSTGRES_PASSWORD=csm_local_password
