# Copy to .env to override Compose defaults. Never commit the real .env.

# Ports exposed on the host
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Leave blank to demo the graceful "AI not configured" state.
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-dev-only-4c1d5f9a8e2b7c3d6a0f1e9b8c7d5a4f3e2d1c0b9a8f7e6d5c4b3a291807f6e5

# Must match the browser-facing frontend origin
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Initial administrator and demo data
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=AdminPass123!
BOOTSTRAP_ADMIN_NAME=Platform Admin
SEED_DEMO_DATA=true
ALLOW_REGISTRATION=true

# Database password used inside the Compose network
POSTGRES_PASSWORD=csm_local_password
